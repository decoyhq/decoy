{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "1 day",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 3,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "One PR for stable minor/patch bumps; 0.x minors can break, so they stay separate.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "non-major dependencies"
    },
    {
      "description": "@types/node follows the Node major we run (.prototools, engines).",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "24.x"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
