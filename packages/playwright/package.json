{
  "name": "@decoyhq/playwright",
  "version": "0.2.0",
  "description": "Playwright fixtures and global setup for the native Decoy runtime.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decoyhq/decoy.git",
    "directory": "packages/playwright"
  },
  "exports": {
    ".": {
      "@decoyhq/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "test": "rstest run",
    "typecheck": "tsc",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "expect-type": "^1.4.0"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  }
}
