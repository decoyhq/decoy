{
  "name": "decoy-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A portable local mock tool.",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "prepare": "pnpm run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "check": "node scripts/versions.mjs check && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@rslib/core": "^1.0.3",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-v8": "^0.12.3",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "~17.13.0",
    "jiti": "^2.7.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
