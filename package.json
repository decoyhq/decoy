{
  "name": "decoy-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A portable local mock tool.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "prepare": "pnpm run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "check": "node scripts/versions.mjs check && oxlint . && prettier --check .",
    "fix": "oxlint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cloudflare/oxlint-config": "0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@rslib/core": "^1.0.3",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-v8": "^0.12.3",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "lefthook": "^2.2.2",
    "oxlint": "1.95.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
